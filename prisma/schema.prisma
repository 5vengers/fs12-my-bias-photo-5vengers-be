generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String             @id @default(uuid()) @db.Uuid
  email             String             @unique @db.VarChar(255)
  password          String?
  nickname          String             @unique @db.VarChar(20)
  provider          Provider
  providerId        String?            @map("provider_id")
  createdAt         DateTime           @default(now()) @map("created_at")
  creationLogs      CardCreationLog[]
  exchangeProposals ExchangeProposal[]
  histories         History[]          @relation("HistoryChangedBy")
  marketItems       MarketItem[]
  myCards           MyCard[]
  notifications     Notification[]
  orders            Order[]
  photoCards        PhotoCard[]
  pointLogs         PointLog[]
  refreshTokens     RefreshToken[]
  userPoint         UserPoint?

  @@unique([provider, providerId])
  @@map("users")
}

model UserPoint {
  id         Int       @id @default(autoincrement())
  userId     String    @unique @map("user_id") @db.Uuid
  point      Int       @default(0)
  lastSpinAt DateTime? @map("last_spin_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  user       User      @relation(fields: [userId], references: [id])

  @@map("user_points")
}

model PhotoCard {
  id            Int       @id @default(autoincrement())
  creatorId     String    @map("creator_id") @db.Uuid
  name          String
  description   String?
  genre         Genre
  grade         CardGrade
  price         Int
  totalQuantity Int       @map("total_quantity")
  imageUrl      String    @map("image_url")
  createdAt     DateTime  @default(now()) @map("created_at")
  myCards       MyCard[]
  creator       User      @relation(fields: [creatorId], references: [id])

  @@map("photo_cards")
}

model MyCard {
  id               Int                @id @default(autoincrement())
  ownerId          String             @map("owner_id") @db.Uuid
  photoCardId      Int                @map("photo_card_id")
  quantity         Int                @default(1)
  acquiredAt       DateTime           @default(now()) @map("acquired_at")
  offeredExchanges ExchangeProposal[] @relation("OfferedCardRelation")
  marketItems      MarketItem[]
  owner            User               @relation(fields: [ownerId], references: [id])
  photoCard        PhotoCard          @relation(fields: [photoCardId], references: [id])

  @@unique([ownerId, photoCardId])
  @@index([ownerId])
  @@map("my_cards")
}

model MarketItem {
  id                Int                @id @default(autoincrement())
  sellerId          String             @map("seller_id") @db.Uuid
  myCardId          Int                @map("my_card_id")
  grade             CardGrade
  genre             Genre
  quantity          Int
  soldQuantity      Int                @default(0) @map("sold_quantity")
  pricePerCard      Int                @map("price_per_card")
  wantedGrade       CardGrade?         @map("wanted_grade")
  wantedGenre       Genre?             @map("wanted_genre")
  wantedDescription String?            @map("wanted_description")
  status            MarketStatus       @default(SELLING)
  createdAt         DateTime           @default(now()) @map("created_at")
  exchangeProposals ExchangeProposal[]
  myCard            MyCard             @relation(fields: [myCardId], references: [id])
  seller            User               @relation(fields: [sellerId], references: [id])
  orders            Order[]

  @@index([myCardId, status])
  @@map("market_items")
}

model ExchangeProposal {
  id            Int            @id @default(autoincrement())
  marketItemId  Int            @map("market_item_id")
  proposerId    String         @map("proposer_id") @db.Uuid
  offeredCardId Int            @map("offered_card_id")
  status        ExchangeStatus @default(WAITING)
  createdAt     DateTime       @default(now()) @map("created_at")
  marketItem    MarketItem     @relation(fields: [marketItemId], references: [id])
  offeredCard   MyCard         @relation("OfferedCardRelation", fields: [offeredCardId], references: [id])
  proposer      User           @relation(fields: [proposerId], references: [id])

  @@map("exchange_proposals")
}

model Order {
  id           Int        @id @default(autoincrement())
  buyerId      String     @map("buyer_id") @db.Uuid
  marketItemId Int        @map("market_item_id")
  quantity     Int
  totalPrice   Int        @map("total_price")
  createdAt    DateTime   @default(now()) @map("created_at")
  buyer        User       @relation(fields: [buyerId], references: [id])
  marketItem   MarketItem @relation(fields: [marketItemId], references: [id])

  @@map("orders")
}

model PointLog {
  id            Int                 @id @default(autoincrement())
  userId        String              @map("user_id") @db.Uuid
  type          PointLogType
  amount        Int
  createdAt     DateTime            @default(now()) @map("created_at")
  balanceAfter  Int                 @map("balance_after")
  description   String?
  referenceId   Int?                @map("reference_id")
  referenceType PointReferenceType? @map("reference_type")
  user          User                @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
  @@map("point_logs")
}

model Notification {
  id        Int              @id @default(autoincrement())
  userId    String           @map("user_id") @db.Uuid
  type      NotificationType
  routeType RouteType        @map("route_type")
  targetId  Int?             @map("target_id")
  message   String
  isRead    Boolean          @default(false) @map("is_read")
  createdAt DateTime         @default(now()) @map("created_at")
  user      User             @relation(fields: [userId], references: [id])

  @@map("notifications")
}

model CardCreationLog {
  id     Int    @id @default(autoincrement())
  userId String @map("user_id") @db.Uuid
  year   Int
  month  Int
  count  Int    @default(0)
  user   User   @relation(fields: [userId], references: [id])

  @@unique([userId, year, month])
  @@map("card_creation_logs")
}

model RefreshToken {
  id        Int      @id @default(autoincrement())
  userId    String   @map("user_id") @db.Uuid
  token     String   @unique
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("refresh_tokens")
}

model History {
  id            BigInt        @id @default(autoincrement())
  recordId      BigInt        @map("record_id")
  tableName     String        @map("table_name") @db.VarChar(50)
  operationType OperationType @map("operation_type")
  oldData       Json?         @map("old_data")
  newData       Json?         @map("new_data")
  changedBy     String?       @map("changed_by") @db.Uuid
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  user          User?         @relation("HistoryChangedBy", fields: [changedBy], references: [id])

  @@index([tableName])
  @@index([recordId])
  @@index([changedBy])
  @@index([createdAt])
  @@index([tableName, recordId])
  @@map("history")
}

enum Provider {
  LOCAL
  GOOGLE
}

enum CardGrade {
  COMMON
  RARE
  SUPER_RARE
  LEGENDARY
}

enum Genre {
  ALBUM
  BENEFIT
  FANSIGN
  SEASON_GREETING
  FAN_MEETING
  CONCERT
  MD
  COLLAB
  FAN_CLUB
  ETC
}

enum MarketStatus {
  SELLING
  SOLD_OUT
  DELETED
}

enum ExchangeStatus {
  WAITING
  APPROVED
  REJECTED
  CANCELLED
}

enum PointLogType {
  EARN
  SPEND
  BOX
}

enum PointReferenceType {
  ORDER
  POINT_BOX
  SALE
}

enum NotificationType {
  TRADE_REQUEST
  TRADE_ACCEPTED
  TRADE_REJECTED
  CARD_PURCHASED
  CARD_SOLD
  CARD_SOLD_OUT
}

enum RouteType {
  MARKET_ITEM
  EXCHANGE_PROPOSAL
  MY_GALLERY
  MY_SELL_CARDS
}

enum OperationType {
  INSERT
  UPDATE
  DELETED
}
